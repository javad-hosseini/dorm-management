# ==============================================================================
# Dormitory Management System - Production Environment Configuration
# Copy this file to .env on your server and replace the placeholder values.
# ==============================================================================

# Security
SECRET_KEY=change-this-to-a-very-long-and-random-secret-key-in-production
DEBUG=False

# Host & Domains (Comma-separated list of your domain names or server IP)
ALLOWED_HOSTS=yourdomain.ir,www.yourdomain.ir,127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=https://yourdomain.ir,https://www.yourdomain.ir,http://localhost:8000

# SSL Enforcement (Set to True once SSL certificates are installed)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Database (For Docker Compose, host is 'db')
DB_NAME=dormitory_db
DB_USER=postgres
DB_PASSWORD=your_secure_db_password_here
DB_HOST=db
DB_PORT=5432

# MeliPayamak SMS Gateway
MELIPAYAMAK_API_TOKEN=your_melipayamak_api_token
MELIPAYAMAK_SENDER=50004001080756
MELIPAYAMAK_API_BASE_URL=https://console.melipayamak.com/api/send/simple
SMS_CONSOLE_MODE=False
