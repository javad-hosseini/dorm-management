# ==============================================================================
# Dormitory Telegram Bot Environment Configuration
# ==============================================================================

# Telegram Bot API Token obtained from @BotFather
BOT_TOKEN=123456789:ABCDefGhIJklMNopQRstUVwxyz_SAMPLE_TOKEN

# Security: Comma-separated list of whitelisted Telegram User IDs
# Find your Telegram User ID using @userinfobot or @rawdatabot
ALLOWED_TELEGRAM_USER_IDS=123456789,987654321

# Optional: Proxy URL for connecting to Telegram API in restricted networks
# Examples: "http://127.0.0.1:2080" or "socks5://127.0.0.1:10808"
TELEGRAM_PROXY_URL=

# Local Persistent Storage
DATA_DIR=data
DB_PATH=data/dormitory_bot.db
SESSIONS_DIR=data/sessions

# Spreadsheet Upload Drop-Zone (SFTP-like channel for manual Antigravity CLI)
# Uploaded .xlsx files and companion instructions are placed here directly
SPREADSHEET_UPLOAD_DIR=incoming_spreadsheets
OVERWRITE_EXISTING_FILES=true

# Raw Data Excel & Image Options
MAX_IMAGE_DIMENSION_PX=320
CLEANUP_TEMP_FILES_ON_FINISH=false

# Spreadsheet Ingestion / Processing Mode
# Options:
# - "file_dropzone": (DEFAULT) Saves .xlsx & instructions to SPREADSHEET_UPLOAD_DIR for manual Antigravity CLI processing (No external API calls)
# - "mock_dry_run": Simulates ledger processing locally
# - "agent_webhook": Outbound HTTP webhook call to external Dormitory Agent API
# - "openai_compatible_agent": Outbound LLM chat completions call
INGESTION_MODE=file_dropzone

# Optional: Agent Webhook / REST API Mode Configuration (only if INGESTION_MODE=agent_webhook)
DORMITORY_AGENT_API_URL=https://agent.dormitory.example.com/api/v1/ingest
DORMITORY_AGENT_API_KEY=your_agent_secret_key_here
DORMITORY_BACKEND_API_URL=https://backend.dormitory.example.com/api/v1/ledger

# 2. OpenAI-Compatible LLM Agent Mode Configuration
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-your-openai-or-compatible-api-key
AGENT_MODEL=gpt-4o-mini

# Custom Ingestion Instructions (Leave empty to use config/default_agent_instructions.md)
DEFAULT_AGENT_INSTRUCTIONS=

